generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  idRol    Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Provincia {
  idProvincia Int         @id @default(autoincrement())
  nombre      String      @unique
  localidades Localidad[]
}

model Localidad {
  idLocalidad Int       @id @default(autoincrement())
  nombre      String
  idProvincia Int

  provincia Provincia @relation(fields: [idProvincia], references: [idProvincia])

  sucursales        Sucursal[]
  pedidosDelivery   Pedido[]
  sucursalesDelivery SucursalLocalidad[]

  @@unique([nombre, idProvincia])
}

// Datos del restaurante. El sistema es single-tenant: siempre hay UNA sola fila (id 1).
// La migración agrega un CHECK en la base que rechaza cualquier otro id.
model Negocio {
  idNegocio   Int     @id @default(1)
  nombre      String
  descripcion String?
  // Ruta dentro del bucket de Supabase Storage. Solo se muestra en el menú digital del cliente.
  logoPath    String?
  instagram   String?
  tiktok      String?
  facebook    String?
  // Datos para que el cliente pague por transferencia desde el menú digital. Esa opción
  // se ofrece solo si están los tres: titular, alias y CUIT/CUIL. El CUIT no sirve para
  // transferir: el cliente lo compara con el que le muestra su banco al usar el alias.
  transferenciaAlias   String?
  // Solo los 11 dígitos, sin guiones (se agregan al mostrarlo).
  transferenciaCuit    String? @db.VarChar(11)
  transferenciaTitular String?
}

model Sucursal {
  idSucursal Int     @id @default(autoincrement())
  nombre     String
  // Segmento de la URL pública (/{slug}). Se genera al crear la sucursal y el admin lo puede
  // cambiar. Los links viejos quedan en SlugAnterior y redirigen al actual, así los QR
  // impresos con la URL anterior siguen funcionando.
  slug       String  @unique
  whatsapp   String?
  direccion  String
  horario    String?
  // Link de la ficha del local en Google Maps (opcional). Solo se aceptan links de Maps
  // (ver linkMapsValido). Si falta, la carta busca por dirección.
  linkMaps   String?
  activa     Boolean @default(true)
  // Formas de entrega que ofrece en el menú digital (siempre al menos una).
  ofreceRetiro   Boolean @default(true)
  ofreceDelivery Boolean @default(true)
  // En desuso: el costo del envío ahora va por localidad (SucursalLocalidad.costoEnvio).
  // Se borran en una migración aparte cuando este cambio esté en producción.
  tramosDelivery Json @default("[]")
  radioDeliveryKm Float?
  recargoFueraRadio Float?
  radioMaximoKm   Float?
  // El local puede pausar los pedidos online a mano, aunque esté dentro del horario.
  pausaPedidosOnline Boolean @default(false)
  // latitud/longitud: ubicación del local (Georef). Se usa para listar las localidades
  // cercanas al configurar el delivery y para sugerir direcciones al cliente.
  latitud         Float?
  longitud        Float?

  idLocalidad Int
  localidad   Localidad @relation(fields: [idLocalidad], references: [idLocalidad])

  usuarios           Usuario[]
  productos          SucursalProducto[]
  pedidos            Pedido[]
  localidadesDelivery SucursalLocalidad[]
  slugsAnteriores     SlugAnterior[]
  cajas               Caja[]
  horarios            HorarioSucursal[]
  accesosPantalla     AccesoPantalla[]
}

// Zonas de delivery: a qué localidades entrega cada sucursal y cuánto cobra el envío en
// cada una (pesos enteros). Una dirección fuera de estas localidades no puede pedir delivery.
model SucursalLocalidad {
  idSucursal  Int
  idLocalidad Int
  costoEnvio  Float

  sucursal  Sucursal  @relation(fields: [idSucursal], references: [idSucursal])
  localidad Localidad @relation(fields: [idLocalidad], references: [idLocalidad])

  @@id([idSucursal, idLocalidad])
}

model Usuario {
  idUsuario    Int     @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String  @unique
  passwordHash String
  debeCambiarContrasena Boolean @default(true)
  activo       Boolean @default(true)
  // Ruta dentro del bucket de Supabase Storage (ej: avatares/12.webp). Null = avatar por defecto.
  fotoPerfilPath String?

  idRol Int
  rol   Rol @relation(fields: [idRol], references: [idRol])

  idSucursal Int?
  sucursal   Sucursal? @relation(fields: [idSucursal], references: [idSucursal])

  // PIN de 4 dígitos para cobrar en Caja y en "Entregado y cobrado". No se guarda el PIN: se
  // guarda su HMAC (con una clave del servidor), que es igual para el mismo PIN. Así se puede
  // exigir que dos personas no tengan el mismo y buscar a quién pertenece un PIN al cobrar.
  // Null = todavía no eligió PIN.
  pinClave String? @unique
  // Bloqueo por intentos fallidos, guardado en la base para que valga en todas las
  // instancias. El login lleva su cuenta; los PIN equivocados se cuentan sobre la persona
  // que tiene la sesión abierta en Caja (no se sabe de quién era el PIN que se probó).
  intentosFallidos    Int       @default(0)
  bloqueadoHasta      DateTime?
  pinIntentosFallidos Int       @default(0)
  pinBloqueadoHasta   DateTime?

  pedidosCargados   Pedido[]
  turnosAbiertos    TurnoCaja[]    @relation("TurnoApertura")
  turnosCerrados    TurnoCaja[]    @relation("TurnoCierre")
  pagosCobrados     Pago[]
  eventosPedido     EventoPedido[]
}

model Categoria {
  idCategoria Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  orden       Int
  activa      Boolean @default(true)
  // Nombres de variaciones sugeridos para los productos de esta categoría
  // (ej: ["Chica", "Mediana", "Grande"]). Las variaciones reales, con precio, están en Variacion.
  nombresVariaciones String[] @default([])

  productos Producto[]
  extras    Extra[]
}

model Producto {
  idProducto  Int     @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  activo      Boolean @default(true)
  // Ruta dentro del bucket de Supabase Storage (ej: productos/42.webp). Null = sin imagen.
  imagenPath  String?

  idCategoria Int
  categoria   Categoria @relation(fields: [idCategoria], references: [idCategoria])

  sucursales       SucursalProducto[]
  variaciones      Variacion[]
  extras           ProductoExtra[]
  detallesPedido   DetallePedido[]
  historialPrecios HistorialPrecioProducto[]
}

model SucursalProducto {
  idSucursal Int
  idProducto Int
  disponible Boolean @default(true)

  sucursal Sucursal @relation(fields: [idSucursal], references: [idSucursal])
  producto Producto @relation(fields: [idProducto], references: [idProducto])

  @@id([idSucursal, idProducto])
}

model Variacion {
  idVariacion     Int     @id @default(autoincrement())
  nombre          String
  precioAdicional Float
  disponible      Boolean @default(true)

  idProducto Int
  producto   Producto @relation(fields: [idProducto], references: [idProducto])

  detallesPedido    DetallePedido[]
  historialPrecios HistorialPrecioVariacion[]
}

model Extra {
  idExtra         Int     @id @default(autoincrement())
  nombre          String
  precioAdicional Float
  activo          Boolean @default(true)

  // Cada extra es de una categoría (el cheddar de hamburguesas no es el de panchos) y solo
  // se asigna a productos de esa categoría. El nombre no se repite dentro de la categoría.
  idCategoria Int
  categoria   Categoria @relation(fields: [idCategoria], references: [idCategoria])

  productos       ProductoExtra[]
  detallesElegidos DetallePedidoExtra[]
}

model ProductoExtra {
  idProducto Int
  idExtra    Int

  producto Producto @relation(fields: [idProducto], references: [idProducto])
  extra    Extra    @relation(fields: [idExtra], references: [idExtra])

  @@id([idProducto, idExtra])
}

model Cliente {
  idCliente Int    @id @default(autoincrement())
  nombre    String
  apellido  String?
  // Celular (10 dígitos, formato nacional). Null solo en pedidos de Caja para retirar:
  // ahí no se pide (ver lib/pedidos-validacion.ts).
  telefono  String?
  email     String?

  pedidos Pedido[]
}

model TipoEntrega {
  idTipoEntrega Int    @id @default(autoincrement())
  nombre        String @unique

  pedidos Pedido[]
}

model Descuento {
  idDescuento  Int     @id @default(autoincrement())
  descripcion  String
  porcentaje   Float
  activo       Boolean @default(true)

  pedidos Pedido[]
}

model Pedido {
  idPedido Int      @id @default(autoincrement())
  fecha    DateTime @default(now())

  // Cuándo llegó a Cocina (estado "recibido"). Una transferencia no cuenta hasta que se
  // confirma el pago. Null en pedidos que todavía no llegaron o que se cargaron antes.
  fechaEnCocina DateTime?
  // Cuándo se marcó "listo". Null si todavía no está listo.
  fechaListo    DateTime?

  origenPedido String
  estadoPedido String
  metodoPago   String
  estadoPago   String

  direccion String?
  // Indicaciones para el repartidor (solo delivery, hasta 200 caracteres).
  referencias String?
  // Aclaración para la cocina, para todo el pedido (ej: "2 sin cebolla, la otra completa").
  aclaracion String? @db.VarChar(200)

  subtotal  Float
  // Importe aceptado al crear el pedido: no cambia al editar la tarifa del local.
  recargoDelivery Float @default(0)
  total     Float

  idCliente Int
  cliente   Cliente @relation(fields: [idCliente], references: [idCliente])

  idSucursal Int
  sucursal   Sucursal @relation(fields: [idSucursal], references: [idSucursal])

  idUsuario Int?
  usuario   Usuario? @relation(fields: [idUsuario], references: [idUsuario])

  idTipoEntrega Int
  tipoEntrega   TipoEntrega @relation(fields: [idTipoEntrega], references: [idTipoEntrega])

  idLocalidad Int?
  localidad   Localidad? @relation(fields: [idLocalidad], references: [idLocalidad])

  idDescuento Int?
  descuento   Descuento? @relation(fields: [idDescuento], references: [idDescuento])

  detalles  DetallePedido[]
  pagos     Pago[]
  eventos   EventoPedido[]
}

model DetallePedido {
  idDetalle Int @id @default(autoincrement())

  cantidad                Int
  precioBaseAplicado      Float
  precioVariacionAplicado Float
  precioUnitario          Float
  subtotal                Float

  idPedido Int
  pedido   Pedido @relation(fields: [idPedido], references: [idPedido])

  idProducto Int
  producto   Producto @relation(fields: [idProducto], references: [idProducto])

  idVariacion Int?
  variacion   Variacion? @relation(fields: [idVariacion], references: [idVariacion])

  extras DetallePedidoExtra[]
}

model DetallePedidoExtra {
  idDetalle Int
  idExtra   Int

  precioExtraAplicado Float

  detalle DetallePedido @relation(fields: [idDetalle], references: [idDetalle])
  extra   Extra         @relation(fields: [idExtra], references: [idExtra])

  @@id([idDetalle, idExtra])
}

model HistorialPrecioProducto {
  idHistorial Int      @id @default(autoincrement())
  precioAnterior Float?
  precioNuevo    Float
  fechaCambio      DateTime @default(now())

  idProducto Int
  producto   Producto @relation(fields: [idProducto], references: [idProducto])


}

// Guarda el precio final de una variación (precio base + adicional) para que
// los cambios se consulten con el valor que realmente ve el cliente.
model HistorialPrecioVariacion {
  idHistorial    Int      @id @default(autoincrement())
  precioAnterior Float?
  precioNuevo    Float
  fechaCambio    DateTime @default(now())

  idVariacion Int
  variacion   Variacion @relation(fields: [idVariacion], references: [idVariacion], onDelete: Cascade)

  @@index([idVariacion, fechaCambio])
}

// Links viejos de la carta de cada sucursal. Cuando se cambia el slug, el anterior queda
// acá y redirige al actual, así los QR impresos y los links compartidos siguen funcionando.
model SlugAnterior {
  slug       String   @id
  idSucursal Int
  creadoEn   DateTime @default(now())

  sucursal Sucursal @relation(fields: [idSucursal], references: [idSucursal])

  @@index([idSucursal])
}

// ---- Caja, pagos y registro de acciones ----

// Puesto de cobro de una sucursal. Un local chico tiene una; uno grande, varias a la vez.
model Caja {
  idCaja     Int     @id @default(autoincrement())
  nombre     String
  activa     Boolean @default(true)

  idSucursal Int
  sucursal   Sucursal @relation(fields: [idSucursal], references: [idSucursal])

  turnos TurnoCaja[]

  @@unique([idSucursal, nombre])
}

// Un turno va de la apertura al cierre de una caja (no es por día: puede haber dos en el
// mismo día). El responsable es quien abrió. Una caja tiene a lo sumo un turno abierto
// (la migración lo asegura con un índice único parcial).
model TurnoCaja {
  idTurno       Int       @id @default(autoincrement())
  fechaApertura DateTime  @default(now())
  fechaCierre   DateTime?
  // Efectivo con el que se abre la caja.
  montoInicial  Float     @default(0)
  // Arqueo al cerrar: lo que el sistema esperaba (inicial + efectivo cobrado) y lo que se
  // contó. La diferencia se calcula restando.
  efectivoEsperado Float?
  efectivoContado  Float?
  observacion      String?

  idCaja Int
  caja   Caja @relation(fields: [idCaja], references: [idCaja])

  idUsuarioApertura Int
  usuarioApertura   Usuario @relation("TurnoApertura", fields: [idUsuarioApertura], references: [idUsuario])

  idUsuarioCierre Int?
  usuarioCierre   Usuario? @relation("TurnoCierre", fields: [idUsuarioCierre], references: [idUsuario])

  pagos Pago[]

  @@index([idCaja, fechaApertura])
}

// Cada cobro de un pedido. Un pedido puede tener varios (pago dividido entre efectivo y
// transferencia). Pedido.metodoPago pasa a valer 'mixto' en esos casos.
model Pago {
  idPago  Int      @id @default(autoincrement())
  // 'efectivo' o 'transferencia'.
  metodo  String
  monto   Float
  fecha   DateTime @default(now())

  idPedido Int
  pedido   Pedido @relation(fields: [idPedido], references: [idPedido])

  // Quién cobró (se identifica con su PIN). Null en pagos anteriores a esta tabla.
  idUsuario Int?
  usuario   Usuario? @relation(fields: [idUsuario], references: [idUsuario])

  // Turno de caja en el que entró la plata. Null en pagos anteriores a esta tabla.
  idTurno Int?
  turno   TurnoCaja? @relation(fields: [idTurno], references: [idTurno])

  @@index([idPedido])
  @@index([idTurno])
}

// Acciones sensibles sobre un pedido: cancelación y modificación, con quién, cuándo y por
// qué. Cocina y Entregas no registran a nadie. Contar las cancelaciones de un celular sale
// de acá (tipo 'cancelacion' + el celular del cliente del pedido).
model EventoPedido {
  idEvento Int      @id @default(autoincrement())
  // 'cancelacion' | 'modificacion'.
  tipo     String
  motivo   String?
  // Qué cambió (por ejemplo, los productos agregados).
  detalle  Json?
  fecha    DateTime @default(now())

  idPedido Int
  pedido   Pedido @relation(fields: [idPedido], references: [idPedido])

  idUsuario Int?
  usuario   Usuario? @relation(fields: [idUsuario], references: [idUsuario])

  @@index([idPedido])
}

// Horario en que cada sucursal acepta pedidos online. Una fila por franja: un local con
// turno partido (8 a 13 y 18 a 23:30) tiene dos filas el mismo día. Los horarios se guardan
// en minutos desde las 00:00 (hora de Argentina); si el local cierra pasada la medianoche,
// cierraMin supera 1440. Sin filas = sin restricción (se mantiene el comportamiento actual).
model HorarioSucursal {
  idHorario  Int @id @default(autoincrement())
  // 0 = domingo ... 6 = sábado.
  diaSemana  Int
  abreMin    Int
  cierraMin  Int

  idSucursal Int
  sucursal   Sucursal @relation(fields: [idSucursal], references: [idSucursal])

  @@index([idSucursal, diaSemana])
}

// Acceso propio de una pantalla (Cocina, Entregas, Mostrador) de una sucursal: no depende
// de la sesión de ninguna persona. El link lleva un código al azar; acá solo se guarda su
// hash. El administrador lo puede revocar.
model AccesoPantalla {
  idAcceso  Int       @id @default(autoincrement())
  // 'cocina' | 'entregas' | 'mostrador'.
  tipo      String
  tokenHash String    @unique
  creadoEn  DateTime  @default(now())
  revocadoEn DateTime?

  idSucursal Int
  sucursal   Sucursal @relation(fields: [idSucursal], references: [idSucursal])

  @@index([idSucursal])
}
